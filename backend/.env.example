# Copy to backend/.env for local development. Never commit the real file.

# Neon pooled connection string (host contains "-pooler").
# Locally use the "dev" branch; Render uses the "production" branch.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Where the frontend runs; Stripe sends the buyer back here after paying.
# Locally http://localhost:5173, on Render the Vercel URL.
APP_URL=http://localhost:5173

# Stripe TEST mode secret key (Dashboard → Developers → API keys). Never a live key.
STRIPE_SECRET_KEY=sk_test_...

# Signing secret of the webhook endpoint (production only: Stripe cannot reach localhost).
# Locally the order page asks Stripe directly, so this can stay empty.
STRIPE_WEBHOOK_SECRET=
