{
    "name": "nojsar/eneba-marketplace-api",
    "description": "REST API for the Eneba-style marketplace. Plain PHP, no framework.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-pdo_pgsql": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php -S localhost:8000 -t public public/index.php"
        ]
    }
}
